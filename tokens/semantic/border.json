          "$value": "{stroke.width.default}",
          "$type": "dimension"
        },
        "color": {
          "$value": "{color.border.default}",
          "$type": "color"
        }
      },
      "focused": {
        "width": {
          "$value": "{stroke.width.default}",
          "$type": "dimension"
        },
        "color": {
          "$value": "{color.border.focus}",
          "$type": "color"
        }
      },
      "disabled": {
        "width": {
          "$value": "{stroke.width.default}",
          "$type": "dimension"
