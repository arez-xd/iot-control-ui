{
  "size": {
    "hitArea": {
      "min": { "$value": "{size.44}", "$type": "dimension" }
    },

    "control": {
      "height": {
        "compact": { "$value": "{size.36}", "$type": "dimension" },
        "default": { "$value": "{size.44}", "$type": "dimension" },
        "lg": { "$value": "{size.48}", "$type": "dimension" }
      }
    },

    "field": {
      "height": {
        "default": { "$value": "{size.44}", "$type": "dimension" },
        "lg": { "$value": "{size.48}", "$type": "dimension" }
      }
    },

    "icon": {
      "xs": { "$value": "{size.12}", "$type": "dimension" },
      "sm": { "$value": "{size.16}", "$type": "dimension" },
      "md": { "$value": "{size.20}", "$type": "dimension" },
      "lg": { "$value": "{size.24}", "$type": "dimension" },
      "xl": { "$value": "{size.32}", "$type": "dimension" }
    },

    "avatar": {
      "sm": { "$value": "{size.28}", "$type": "dimension" },
      "md": { "$value": "{size.36}", "$type": "dimension" },
      "lg": { "$value": "{size.44}", "$type": "dimension" }
    },

    "divider": {
      "default": { "$value": "{stroke.1}", "$type": "dimension" },
      "strong": { "$value": "{stroke.2}", "$type": "dimension" }
    },

    "button": {
      "icon": {
        "sm": { "$value": "{size.icon.sm}", "$type": "dimension" },
        "md": { "$value": "{size.icon.md}", "$type": "dimension" }
      },
      "iconOnly": {
        "min": { "$value": "{size.hitArea.min}", "$type": "dimension" }
      }
    }
  }
}
