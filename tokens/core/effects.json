{
  "effects": {
    "shadow": {
      "1": {
        "$type": "shadow",
        "$value": {
          "color": "#0000003D",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px"
        }
      }
    },
    "highlight": {
      "1": {
        "$type": "shadow",
        "$value": {
          "color": "#FFFFFF14",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px"
        }
      }
    },
    "scrim": {
      "modal": {
        "$value": "#00000099",
        "$type": "color"
      }
    }
  }
}
