{
  "color": {
    "base": {
      "neutral": {
        "0":   { "$value": "#FFFFFF", "$type": "color" },
        "50":  { "$value": "#F5F7FA", "$type": "color" },
        "100": { "$value": "#E8ECF2", "$type": "color" },
        "200": { "$value": "#D0D7E2", "$type": "color" },
