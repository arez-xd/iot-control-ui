    "alpha": {
      "white": {
        "5":  { "$value": "rgba(255,255,255,0.05)", "$type": "color" },
        "10": { "$value": "rgba(255,255,255,0.10)", "$type": "color" },
        "20": { "$value": "rgba(255,255,255,0.20)", "$type": "color" },
        "40": { "$value": "rgba(255,255,255,0.40)", "$type": "color" },
        "60": { "$value": "rgba(255,255,255,0.60)", "$type": "color" }
