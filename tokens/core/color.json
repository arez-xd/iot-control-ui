    "special": {
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "black": { "$value": "#000000", "$type": "color" }
    },

    "data": {
      "series": {
        "1": { "$value": "#007AFF", "$type": "color" },
        "2": { "$value": "#00F2FF", "$type": "color" },
        "3": { "$value": "#00F5A0", "$type": "color" },
