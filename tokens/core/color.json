        "200": { "$value": "#FFE7AD", "$type": "color" },
        "300": { "$value": "#FFD27A", "$type": "color" },
        "400": { "$value": "#FFB84D", "$type": "color" },
        "500": { "$value": "#FF9F0A", "$type": "color" },
        "600": { "$value": "#CC7F08", "$type": "color" }
